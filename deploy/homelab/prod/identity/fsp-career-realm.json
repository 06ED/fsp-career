{
  "realm": "fsp-career",
  "enabled": true,
  "displayName": "ФСП Карьера",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "loginTheme": "fsp-career",
  "internationalizationEnabled": true,
  "supportedLocales": ["ru", "en"],
  "defaultLocale": "ru",
  "smtpServer": {
    "host": "fsp-career-mailpit",
    "port": "1025",
    "from": "no-reply@fsp.local",
    "fromDisplayName": "ФСП Карьера (homelab)",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "candidate", "description": "Candidate profile and assessment access" },
      { "name": "employer", "description": "Employer discovery and invitations; grant manually" },
      { "name": "default-roles-fsp-career", "composite": true, "composites": { "realm": ["candidate"] } }
    ]
  },
  "defaultRole": {
    "name": "default-roles-fsp-career",
    "composite": true,
    "composites": { "realm": ["candidate"] }
  },
  "clients": [
    {
      "clientId": "fsp-service",
      "name": "FSP Career server-side FSP ID login",
      "enabled": true,
      "publicClient": false,
      "secret": "${FSP_CLIENT_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://brokenbrain.online/api/auth/fsp/callback"],
      "webOrigins": [],
      "defaultClientScopes": ["basic", "profile", "email"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "fsp-web",
      "name": "FSP Career web application",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://brokenbrain.online/*"],
      "webOrigins": ["https://brokenbrain.online"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "fsp-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fsp-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "fsp-api",
      "name": "FSP Career API token audience",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ]
}
