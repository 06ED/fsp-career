# Copy to .env for Docker Compose; never commit .env.
# Local-development values only. Change all passwords before using real data.
DATABASE_PORT=5432
DATABASE_USER=fsp_app
DATABASE_PASSWORD=local-only-change-me
KEYCLOAK_PORT=8081
KEYCLOAK_DB_PASSWORD=local-only-keycloak-db
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-only-change-me

# Docker Compose builds and launches ALL services (web :3000, API :8080,
# Keycloak :8081, Mailpit :8025, PostgreSQL :5432). The variables below
# are for optional host-run API development; Compose injects container URLs.
# Compose does not automatically export .env variables to host processes.
DATABASE_URL=jdbc:postgresql://localhost:5432/fsp_career
KEYCLOAK_ISSUER=http://localhost:8081/realms/fsp-career
KEYCLOAK_AUDIENCE=fsp-api

# Browser auth. Compose uses :3000 by default; host-run Vite needs :5173.
# For host-run API: export these explicitly, use FRONTEND_ORIGIN=http://localhost:5173.
FRONTEND_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8080

# Enable the FSP ID button after creating/configuring the confidential Keycloak
# client fsp-service (README: «Авторизация и подключение ФСП ID»).
FSP_CLIENT_ID=
FSP_CLIENT_SECRET=
# FSP_ISSUER / FSP_AUTH_URL / FSP_TOKEN_URL / FSP_JWKS_URL default to our Keycloak
# in Compose. Override ALL four when connecting a different OIDC provider.

# VK ID confidential web application: secret is the application's service token.
VK_CLIENT_ID=
VK_CLIENT_SECRET=
