# Public entry point. PUBLIC_HOST comes from the deploy env file (see compose.prod.yaml).
{$PUBLIC_HOST} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:8080 {
			# The browser calls the API on this same origin; the API's CORS allowlist
			# only knows localhost and would reject the public Origin header.
			header_up -Origin
		}
	}

	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	handle {
		reverse_proxy web:3000
	}
}

www.{$PUBLIC_HOST} {
	redir https://{$PUBLIC_HOST}{uri} permanent
}
